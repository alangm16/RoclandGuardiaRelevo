<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RoclandGuardiaRelevo.Mobile.Views.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoclandGuardiaRelevo.Mobile.ViewModels"
             xmlns:conv="clr-namespace:RoclandGuardiaRelevo.Mobile.Converters"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4F0">

    <ContentPage.Resources>
        <conv:BoolToColorConverter x:Key="BoolToColor"/>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,0,0,36">

            <!-- ─── CABECERA ─── -->
            <Grid HeightRequest="160">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1B3A1B" Offset="0.0"/>
                        <GradientStop Color="#2D6A2D" Offset="1.0"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                      Padding="20,0,20,0" VerticalOptions="Center">

                    <!-- Bienvenida -->
                    <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding FechaHoy}" FontSize="12" TextColor="#9DBF9D"/>
                        <Label Text="{Binding Bienvenida}" FontSize="21"
                               FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Guardia" FontSize="13" TextColor="#A5D6A7"/>
                    </VerticalStackLayout>

                    <!-- Iniciales -->
                    <Frame Grid.Column="1" WidthRequest="48" HeightRequest="48"
                           CornerRadius="24" Padding="0"
                           BackgroundColor="#388E3C" VerticalOptions="Center"
                           Margin="0,0,10,0">
                        <Label Text="{Binding Iniciales}" FontSize="18"
                               FontAttributes="Bold" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>

                    <!-- Botón Actualizar -->
                    <ImageButton Grid.Column="2"
                                 Source="icon_refresh.png"
                                 WidthRequest="28" HeightRequest="28"
                                 VerticalOptions="Center"
                                 BackgroundColor="Transparent" Opacity="0.80"
                                 Margin="0,0,10,0"
                                 Command="{Binding CargarDatosCommand}"/>

                    <!-- Cerrar sesión -->
                    <ImageButton Grid.Column="3"
                                 Source="icon_logout.png"
                                 WidthRequest="26" HeightRequest="26"
                                 VerticalOptions="Center"
                                 BackgroundColor="Transparent" Opacity="0.75"
                                 Command="{Binding CerrarSesionCommand}"/>
                </Grid>
            </Grid>

            <VerticalStackLayout Padding="16,20,16,0" Spacing="16">

                <!-- Indicador de carga -->
                <ActivityIndicator IsVisible="{Binding EstaCargando}"
                                   IsRunning="{Binding EstaCargando}"
                                   Color="#4CAF50" HorizontalOptions="Center"/>

                <!-- ─── TARJETA RONDÍN DISPONIBLE ─── -->
                <Frame BackgroundColor="White" CornerRadius="18" Padding="0"
                       BorderColor="#C8DFC8"
                       Shadow="{Shadow Brush='#18000000', Offset='0,4', Radius='12'}">
                    <VerticalStackLayout Spacing="0">

                        <!-- Encabezado turno -->
                        <Grid BackgroundColor="#1B3A1B" Padding="18,16"
                              ColumnDefinitions="Auto,*,Auto">
                            <Image Grid.Column="0" Source="icon_shift.png"
                                   WidthRequest="22" HeightRequest="22"
                                   VerticalOptions="Center" Opacity="0.75"
                                   Margin="0,0,12,0"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Turno" FontSize="12" TextColor="#9DBF9D"/>
                                <Label Text="{Binding Turno}" FontSize="18"
                                       FontAttributes="Bold" TextColor="White"/>
                            </VerticalStackLayout>
                            <Frame Grid.Column="2" BackgroundColor="#2D6A2D"
                                   CornerRadius="10" Padding="12,6"
                                   BorderColor="Transparent" VerticalOptions="Center">
                                <Label Text="Activo" FontSize="12"
                                       FontAttributes="Bold" TextColor="#A5D6A7"/>
                            </Frame>
                        </Grid>

                        <BoxView HeightRequest="3" Color="#4CAF50" Opacity="0.4"/>

                        <!-- Rondín disponible + botón acción -->
                        <VerticalStackLayout Padding="18,14" Spacing="12">
                            <Label Text="Rondín disponible" FontSize="14"
                                   TextColor="#5A7A5A" HorizontalOptions="Center"/>
                            <Label Text="{Binding TipoRondinDisponible}" FontSize="18"
                                   FontAttributes="Bold" TextColor="#1B3A1B"
                                   HorizontalOptions="Center"/>
                            <Button Text="{Binding TextoBotonAccion}"
                                    Command="{Binding AccionPrincipalCommand}"
                                    BackgroundColor="{Binding RondinDisponible, Converter={StaticResource BoolToColor}}"
                                    TextColor="White" FontAttributes="Bold"
                                    FontSize="16" CornerRadius="14" HeightRequest="54"
                                    IsEnabled="{Binding RondinDisponible}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- ─── RESUMEN DE RONDINES DEL DÍA ─── -->
                <Frame BackgroundColor="White" CornerRadius="18" Padding="18,16"
                       BorderColor="#C8DFC8"
                       Shadow="{Shadow Brush='#18000000', Offset='0,3', Radius='8'}">
                    <VerticalStackLayout Spacing="14">

                        <Label Text="ESTADO DEL DÍA" FontSize="13" FontAttributes="Bold"
                               TextColor="#5A7A5A" CharacterSpacing="1.2"/>

                        <!-- AMS -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <BoxView Grid.Column="0" WidthRequest="4" HeightRequest="32"
                                     CornerRadius="2"
                                     Color="{Binding AmsEnviado, Converter={StaticResource BoolToColor}}"
                                     VerticalOptions="Center" Margin="0,0,12,0"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="AMS — Matutino Saliente" FontSize="14"
                                       FontAttributes="Bold" TextColor="#1B3A1B"/>
                                <Label Text="6:00 – 7:00" FontSize="12" TextColor="#7A9A7A"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{Binding AmsEnviado, Converter={StaticResource BoolToFiltroText}}"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{Binding AmsEnviado, Converter={StaticResource BoolToColor}}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EEF4EE"/>

                        <!-- BME -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <BoxView Grid.Column="0" WidthRequest="4" HeightRequest="32"
                                     CornerRadius="2"
                                     Color="{Binding BmeEnviado, Converter={StaticResource BoolToColor}}"
                                     VerticalOptions="Center" Margin="0,0,12,0"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="BME — Matutino Entrante" FontSize="14"
                                       FontAttributes="Bold" TextColor="#1B3A1B"/>
                                <Label Text="7:00 – 8:00" FontSize="12" TextColor="#7A9A7A"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{Binding BmeEnviado, Converter={StaticResource BoolToFiltroText}}"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{Binding BmeEnviado, Converter={StaticResource BoolToColor}}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EEF4EE"/>

                        <!-- AVS -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <BoxView Grid.Column="0" WidthRequest="4" HeightRequest="32"
                                     CornerRadius="2"
                                     Color="{Binding AvsEnviado, Converter={StaticResource BoolToColor}}"
                                     VerticalOptions="Center" Margin="0,0,12,0"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="AVS — Vespertino Saliente" FontSize="14"
                                       FontAttributes="Bold" TextColor="#1B3A1B"/>
                                <Label Text="18:00 – 19:00" FontSize="12" TextColor="#7A9A7A"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{Binding AvsEnviado, Converter={StaticResource BoolToFiltroText}}"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{Binding AvsEnviado, Converter={StaticResource BoolToColor}}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EEF4EE"/>

                        <!-- BVE -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <BoxView Grid.Column="0" WidthRequest="4" HeightRequest="32"
                                     CornerRadius="2"
                                     Color="{Binding BveEnviado, Converter={StaticResource BoolToColor}}"
                                     VerticalOptions="Center" Margin="0,0,12,0"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="BVE — Vespertino Entrante" FontSize="14"
                                       FontAttributes="Bold" TextColor="#1B3A1B"/>
                                <Label Text="19:00 – 20:00" FontSize="12" TextColor="#7A9A7A"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{Binding BveEnviado, Converter={StaticResource BoolToFiltroText}}"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{Binding BveEnviado, Converter={StaticResource BoolToColor}}"
                                   VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
