<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RoclandGuardiaRelevo.Mobile.Views.IncidenciaPopup"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoclandGuardiaRelevo.Mobile.ViewModels"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4F0">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- TOP BAR — mismo lenguaje visual que RondinPage -->
        <Grid Grid.Row="0" BackgroundColor="#1B3A1B"
              ColumnDefinitions="Auto,*"
              Padding="12,44,16,14">
            <Button Grid.Column="0"
                    Text="✕" FontSize="18" TextColor="White"
                    BackgroundColor="Transparent" BorderColor="Transparent"
                    WidthRequest="44" HeightRequest="44" Padding="0"
                    Command="{Binding CancelarCommand}"/>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Reportar anomalía"
                       FontSize="17" FontAttributes="Bold" TextColor="White"/>
                <Label Text="{Binding PuntoNombre}"
                       FontSize="12" TextColor="#9DBF9D"
                       LineBreakMode="TailTruncation"/>
            </VerticalStackLayout>
        </Grid>

        <!-- CONTENIDO PRINCIPAL -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,8" Spacing="0"
                                 MaximumWidthRequest="600"
                                 HorizontalOptions="Center">

                <!-- Banner de alerta -->
                <Frame BackgroundColor="#FFF3F3" CornerRadius="12"
                       Padding="14,10" BorderColor="#FFCDD2" Margin="0,0,0,20">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="⚠️" FontSize="22" VerticalOptions="Center"/>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Punto marcado como NO OK"
                                   FontSize="13" FontAttributes="Bold" TextColor="#C62828"/>
                            <Label Text="El comentario es obligatorio. La foto es opcional pero recomendada."
                                   FontSize="11" TextColor="#E57373"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Frame>

                <!-- Sección comentario -->
                <Label Text="DESCRIPCIÓN DE LA ANOMALÍA"
                       FontSize="11" FontAttributes="Bold"
                       TextColor="#5A7A5A" CharacterSpacing="1.5"
                       Margin="2,0,0,8"/>

                <Frame BackgroundColor="White" CornerRadius="14"
                       Padding="14" BorderColor="#D4E4D4" Margin="0,0,0,24">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Comentario *"
                               FontSize="12" TextColor="#9AB09A"/>
                        <Editor Placeholder="Describe detalladamente qué encontraste..."
                                PlaceholderColor="#AABFAA"
                                TextColor="#1B3A1B"
                                Text="{Binding Comentario}"
                                FontSize="14"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="100"
                                BackgroundColor="Transparent"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Sección foto -->
                <Label Text="EVIDENCIA FOTOGRÁFICA"
                       FontSize="11" FontAttributes="Bold"
                       TextColor="#5A7A5A" CharacterSpacing="1.5"
                       Margin="2,0,0,8"/>

                <!-- Botón tomar foto (visible cuando NO hay foto) -->
                <Frame IsVisible="{Binding TieneNoFoto}"
                       BackgroundColor="White" CornerRadius="14"
                       Padding="0" BorderColor="#D4E4D4"
                       Margin="0,0,0,8">
                    <Button Text="Tomar foto de evidencia"
                            Command="{Binding TomarFotoCommand}"
                            BackgroundColor="Transparent"
                            BorderColor="Transparent"
                            TextColor="#1B3A1B"
                            FontSize="14"
                            HeightRequest="64"/>
                </Frame>

                <!-- Preview de la foto (visible cuando SÍ hay foto) -->
                <Border IsVisible="{Binding TieneFoto}"
                    Stroke="#4CAF50"
                    StrokeThickness="1.5"
                    Background="White"
                    Padding="12"
                    Margin="0,0,0,8"
                    StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                <Label Text="✅" FontSize="16" VerticalOptions="Center"/>
                                <Label Text="Foto adjuntada"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="#2E7D32" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Cambiar"
                                    Command="{Binding TomarFotoCommand}"
                                    BackgroundColor="Transparent"
                                    BorderColor="Transparent"
                                    TextColor="#5A7A5A"
                                    FontSize="12"
                                    Padding="8,4"/>
                        </Grid>

                        <!-- Imagen preview -->
                        <Image Source="{Binding FotoPreview}"
                               Aspect="AspectFill"
                               HeightRequest="220"
                               HorizontalOptions="Fill"
                               IsVisible="{Binding TieneFoto}">
                            <Image.Clip>
                                <RoundRectangleGeometry Rect="0,0,1000,220" CornerRadius="10"/>
                            </Image.Clip>
                        </Image>
                    </VerticalStackLayout>
                </Border>

                <BoxView HeightRequest="12"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- BARRA INFERIOR -->
        <Grid Grid.Row="2"
              BackgroundColor="White"
              Padding="20,12,20,32"
              ColumnDefinitions="*,*"
              ColumnSpacing="12">
            <Grid.Shadow>
                <Shadow Brush="#20000000" Offset="0,-2" Radius="10"/>
            </Grid.Shadow>

            <Button Grid.Column="0"
                    Text="Cancelar"
                    Command="{Binding CancelarCommand}"
                    BackgroundColor="#F0F4F0"
                    BorderColor="#C8DFC8"
                    BorderWidth="1.5"
                    TextColor="#5A7A5A"
                    FontAttributes="Bold"
                    FontSize="15"
                    CornerRadius="14"
                    HeightRequest="54"/>

            <Button Grid.Column="1"
                    Text="Confirmar"
                    Command="{Binding GuardarCommand}"
                    BackgroundColor="#F44336"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="15"
                    CornerRadius="14"
                    HeightRequest="54"/>
        </Grid>

    </Grid>
</ContentPage>