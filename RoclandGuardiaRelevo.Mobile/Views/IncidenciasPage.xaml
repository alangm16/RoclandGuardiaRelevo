<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RoclandGuardiaRelevo.Mobile.Views.IncidenciasPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoclandGuardiaRelevo.Mobile.ViewModels"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4F0">

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" BackgroundColor="#1B3A1B" Padding="16,44,16,14">
            <Label Text="Incidencias" FontSize="17" FontAttributes="Bold" TextColor="White"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <Grid Grid.Row="1" BackgroundColor="White" Padding="16,12" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" Text="Incidencias" FontSize="14" FontAttributes="Bold" TextColor="#1B3A1B"/>
            <Button Grid.Column="1" Text="{Binding MostrarSoloAbiertas, Converter={StaticResource BoolToFiltroText}}"
                    Command="{Binding AlternarFiltroCommand}" BackgroundColor="#E8F5E9" TextColor="#2E7D32"
                    CornerRadius="10" HeightRequest="32" FontSize="12"/>
        </Grid>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding EstaCargandoIncidencias}"
                     Command="{Binding CargarIncidenciasCommand}">
            <CollectionView ItemsSource="{Binding Incidencias}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="White" CornerRadius="12" Padding="12,10" Margin="12,0,12,8"
                               BorderColor="{Binding Resuelta, Converter={StaticResource ResueltaBorderColor}}">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding Punto}" FontSize="14" FontAttributes="Bold"
                                           TextColor="#1B3A1B"/>
                                    <Label Grid.Column="1" Text="{Binding FechaDeteccionLocal, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                           FontSize="10" TextColor="#9DBF9D"/>
                                </Grid>
                                <Label Text="{Binding DescripcionPunto}"
                                       FontSize="12"
                                       TextColor="#6A8A6A"
                                       LineBreakMode="WordWrap"/>
                                <Label Text="Categoría" FontSize="10" FontAttributes="Bold" TextColor="#5A7A5A"/>
                                <Label Text="{Binding Categoria}" FontSize="11" TextColor="#1B3A1B"/>
                                <Label Text="Discrepancia entre" FontSize="10" FontAttributes="Bold" TextColor="#5A7A5A"/>
                                <Label Text="{Binding GuardiaComparacion}"
                                       FontSize="11"
                                       TextColor="#1B3A1B"/>
                                <Button Text="Resolver" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:IncidenciasViewModel}}, Path=ResolverIncidenciaCommand}"
                                        CommandParameter="{Binding .}" IsVisible="{Binding Resuelta, Converter={StaticResource InvertBool}}"
                                        BackgroundColor="#F44336" TextColor="White" CornerRadius="8" HeightRequest="32"/>
                                <Label Text="✓ Resuelta" IsVisible="{Binding Resuelta}" FontSize="11" TextColor="#4CAF50" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>