<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RoclandGuardiaRelevo.Mobile.Views.FirmaPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             Title="Firma del guardia">

    <VerticalStackLayout Padding="20" Spacing="12">

        <Label Text="Firme aquí:"
               FontSize="16"
               FontAttributes="Bold" />

        <Frame BorderColor="#E0E0E0"
               CornerRadius="10"
               HeightRequest="220"
               Padding="0">

            <skia:SKCanvasView x:Name="FirmaCanvas"
                               EnableTouchEvents="True"
                               PaintSurface="OnPaintSurface"
                               Touch="OnCanvasTouch"
                               BackgroundColor="White" />
        </Frame>

        <HorizontalStackLayout Spacing="12"
                               HorizontalOptions="Center">

            <Button Text="Limpiar"
                    Command="{Binding LimpiarCommand}" />

            <Button Text="Aceptar"
                    Command="{Binding AceptarCommand}" />

            <Button Text="Cancelar"
                    Command="{Binding CancelarCommand}" />

        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>