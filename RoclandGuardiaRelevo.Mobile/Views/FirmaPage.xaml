<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RoclandGuardiaRelevo.Mobile.Views.FirmaPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4F0">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- TOP BAR -->
        <Grid Grid.Row="0" BackgroundColor="#1B3A1B"
              ColumnDefinitions="Auto,*"
              Padding="12,44,16,14">
            <Button Grid.Column="0"
                    Text="✕" FontSize="18" TextColor="White"
                    BackgroundColor="Transparent" BorderColor="Transparent"
                    WidthRequest="44" HeightRequest="44" Padding="0"
                    Command="{Binding CancelarCommand}"/>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Firma del guardia"
                       FontSize="17" FontAttributes="Bold" TextColor="White"/>
                <Label Text="Dibuja tu firma para finalizar el rondín"
                       FontSize="12" TextColor="#9DBF9D"/>
            </VerticalStackLayout>
        </Grid>

        <!-- ÁREA DE FIRMA — ocupa todo el espacio disponible -->
        <Grid Grid.Row="1" Padding="20,20,20,12">
            <Frame
                BorderColor="#C8DFC8"
                BackgroundColor="White"
                CornerRadius="16"
                Padding="0"
                VerticalOptions="Fill"
                MaximumWidthRequest="800"
                HorizontalOptions="Center">
                <Grid>
                    <!-- Canvas táctil -->
                    <skia:SKCanvasView x:Name="FirmaCanvas"
                                       EnableTouchEvents="True"
                                       PaintSurface="OnPaintSurface"
                                       Touch="OnCanvasTouch"
                                       BackgroundColor="White"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill"/>

                    <!-- Guía punteada inferior -->
                    <BoxView HeightRequest="1.5"
                             Color="#D0D0D0"
                             VerticalOptions="End"
                             Margin="32,0,32,54"
                             InputTransparent="True"/>

                    <!-- Hint texto -->
                    <Label Text="Firma aquí"
                           FontSize="13" TextColor="#CCCCCC"
                           HorizontalOptions="Center"
                           VerticalOptions="End"
                           Margin="0,0,0,22"
                           InputTransparent="True"
                           x:Name="HintLabel"/>
                </Grid>
            </Frame>
        </Grid>

        <!-- BARRA INFERIOR -->
        <Grid Grid.Row="2"
              BackgroundColor="White"
              Padding="20,12,20,32"
              ColumnDefinitions="Auto,*,*"
              ColumnSpacing="12">
            <Grid.Shadow>
                <Shadow Brush="#20000000" Offset="0,-2" Radius="10"/>
            </Grid.Shadow>

            <!-- Limpiar — icono pequeño a la izquierda -->
            <Button Grid.Column="0"
                    Text="🗑 Limpiar"
                    Command="{Binding LimpiarCommand}"
                    BackgroundColor="#F0F4F0"
                    BorderColor="#C8DFC8"
                    BorderWidth="1.5"
                    TextColor="#5A7A5A"
                    FontSize="14"
                    CornerRadius="14"
                    HeightRequest="54"
                    WidthRequest="130"/>

            <Button Grid.Column="1"
                    Text="Cancelar"
                    Command="{Binding CancelarCommand}"
                    BackgroundColor="#F0F4F0"
                    BorderColor="#C8DFC8"
                    BorderWidth="1.5"
                    TextColor="#5A7A5A"
                    FontAttributes="Bold"
                    FontSize="15"
                    CornerRadius="14"
                    HeightRequest="54"/>

            <Button Grid.Column="2"
                    Text="Aceptar ✓"
                    Command="{Binding AceptarCommand}"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="15"
                    CornerRadius="14"
                    HeightRequest="54"/>
        </Grid>

    </Grid>
</ContentPage>