<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Name="ThisPage"
             x:Class="RoclandGuardiaRelevo.Mobile.Views.RondinPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoclandGuardiaRelevo.Mobile.ViewModels"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4F0">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- TOP BAR -->
        <Grid Grid.Row="0" BackgroundColor="#1B3A1B"
              ColumnDefinitions="Auto,*"
              Padding="12,44,16,14">
            <Button Grid.Column="0" Text="‹" FontSize="28" TextColor="White"
                    BackgroundColor="Transparent" BorderColor="Transparent"
                    WidthRequest="48" HeightRequest="48" Padding="0"
                    Command="{Binding VolverCommand}"/>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Rondín de relevo" FontSize="19" FontAttributes="Bold" TextColor="White"/>
                <Label Text="{Binding Subtitulo}" FontSize="13" TextColor="#9DBF9D"/>
            </VerticalStackLayout>
        </Grid>

        <!-- BARRA PROGRESO -->
        <Frame Grid.Row="1" BackgroundColor="White" Padding="18,12" CornerRadius="0" BorderColor="#E0EFE0">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding InstruccionTexto}" FontSize="13" TextColor="#5A7A5A"/>
                <Grid ColumnDefinitions="*,Auto">
                    <ProgressBar Grid.Column="0" Progress="{Binding ProgresoValor}"
                                 ProgressColor="#2E7D32" BackgroundColor="#D8E8D8"
                                 HeightRequest="8" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding ProgresoTexto}"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="#1B3A1B" Margin="10,0,0,0"/>
                </Grid>
            </VerticalStackLayout>
        </Frame>

        <!-- LISTA DE PUNTOS -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,14,16,8" Spacing="0">

                <CollectionView ItemsSource="{Binding Categorias}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoriaChecklistVm">
                            <VerticalStackLayout Spacing="8" Margin="0,0,0,18">

                                <!-- Encabezado de categoría -->
                                <Label Text="{Binding Nombre}" FontSize="13" FontAttributes="Bold"
                                       TextColor="#5A7A5A" CharacterSpacing="1.2"
                                       Margin="2,0,0,2" TextTransform="Uppercase"/>

                                <!-- Puntos de la categoría -->
                                <CollectionView ItemsSource="{Binding Puntos}" SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PuntoConRespuesta">
                                            <Frame BackgroundColor="White" CornerRadius="14"
                                                   Padding="14,12" Margin="0,0,0,10"
                                                   BorderColor="#D4E4D4">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                                                    <!-- Nombre y descripción -->
                                                    <VerticalStackLayout Grid.Column="0" Spacing="3"
                                                                         VerticalOptions="Center">
                                                        <Label Text="{Binding Nombre}"
                                                               FontSize="15" FontAttributes="Bold"
                                                               TextColor="#1B3A1B" LineBreakMode="WordWrap"/>
                                                        <Label Text="{Binding Descripcion}"
                                                               FontSize="13" TextColor="#6A8A6A"
                                                               IsVisible="{Binding TieneDescripcion}"
                                                               LineBreakMode="WordWrap"/>
                                                    </VerticalStackLayout>

                                                    <!-- Botones SÍ / NO -->
                                                    <!-- 
                                                         Los comandos se vinculan al ViewModel de la página
                                                         usando x:Reference en lugar de RelativeSource,
                                                         porque RondinViewModel no es un elemento visual.
                                                    -->
                                                    <HorizontalStackLayout Grid.Column="1"
                                                                           Spacing="8"
                                                                           VerticalOptions="Center">

                                                        <Frame Padding="0" CornerRadius="10"
                                                               BackgroundColor="{Binding SiBackground}"
                                                               WidthRequest="64" HeightRequest="46"
                                                               HasShadow="False">
                                                            <Button Text="✓ SÍ"
                                                                    FontSize="14" FontAttributes="Bold"
                                                                    TextColor="{Binding SiTextColor}"
                                                                    BackgroundColor="Transparent"
                                                                    BorderColor="Transparent"
                                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ResponderSiCommand}"
                                                                    CommandParameter="{Binding .}"/>
                                                        </Frame>

                                                        <Frame Padding="0" CornerRadius="10"
                                                               BackgroundColor="{Binding NoBackground}"
                                                               WidthRequest="64" HeightRequest="46"
                                                               HasShadow="False">
                                                            <Button Text="✗ NO"
                                                                    FontSize="14" FontAttributes="Bold"
                                                                    TextColor="{Binding NoTextColor}"
                                                                    BackgroundColor="Transparent"
                                                                    BorderColor="Transparent"
                                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ResponderNoCommand}"
                                                                    CommandParameter="{Binding .}"/>
                                                        </Frame>

                                                    </HorizontalStackLayout>
                                                </Grid>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- OBSERVACIÓN GENERAL -->
                <Label Text="OBSERVACIÓN GENERAL" FontSize="13" FontAttributes="Bold"
                       TextColor="#5A7A5A" CharacterSpacing="1.2" Margin="2,6,0,8"/>
                <Frame BackgroundColor="White" CornerRadius="14" Padding="14" BorderColor="#D4E4D4">
                    <Editor Placeholder="Comentario sobre el rondín (opcional)"
                            PlaceholderColor="#AABFAA" TextColor="#1B3A1B"
                            Text="{Binding ObservacionGeneral}"
                            FontSize="14" AutoSize="TextChanges"
                            MinimumHeightRequest="80"/>
                </Frame>

                <!-- FOTOS DEL RONDÍN -->
                <Label Text="FOTOS DEL RONDÍN" FontSize="13" FontAttributes="Bold"
                       TextColor="#5A7A5A" CharacterSpacing="1.2" Margin="2,16,0,8"/>

                <Button Text="Tomar foto" Clicked="OnTomarFotoClicked"
                        BackgroundColor="#2E7D32" TextColor="White"
                        FontSize="15" FontAttributes="Bold"
                        CornerRadius="12" HeightRequest="50"
                        Margin="0,0,0,10"/>

                <!-- Miniaturas con botón de eliminar -->
                <CollectionView ItemsSource="{Binding FotosPreview}"
                                HeightRequest="110" Margin="0,0,0,16">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FotoPreviewItem">
                            <Grid WidthRequest="95" HeightRequest="95">

                                <Border StrokeShape="RoundRectangle 10"
                                        StrokeThickness="0"
                                        WidthRequest="95" HeightRequest="95">
                                    <Image Source="{Binding Thumbnail}" Aspect="AspectFill"/>
                                </Border>

                                <!-- Botón X para eliminar foto -->
                                <Button Text="✕"
                                        WidthRequest="26" HeightRequest="26"
                                        FontSize="11" FontAttributes="Bold"
                                        BackgroundColor="#CC000000" TextColor="White"
                                        CornerRadius="13" Padding="0"
                                        HorizontalOptions="End" VerticalOptions="Start"
                                        Margin="0,4,4,0"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EliminarFotoCommand}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BARRA INFERIOR - FINALIZAR -->
        <Grid Grid.Row="3" BackgroundColor="White"
              Padding="16,12,16,30" RowDefinitions="Auto,Auto">
            <Grid.Shadow>
                <Shadow Brush="#25000000" Offset="0,-3" Radius="10"/>
            </Grid.Shadow>
            <Label Grid.Row="0"
                   Text="Responde todos los puntos para habilitar el envío"
                   FontSize="13" TextColor="#5A7A5A"
                   HorizontalOptions="Center" Margin="0,0,0,10"/>
            <Button Grid.Row="1"
                    Text="Finalizar rondín"
                    Command="{Binding EnviarRondinCommand}"
                    BackgroundColor="{Binding ColorBoton}"
                    TextColor="White" FontAttributes="Bold"
                    FontSize="16" CornerRadius="14" HeightRequest="54"
                    IsEnabled="{Binding PuedeEnviar}"/>
        </Grid>

    </Grid>
</ContentPage>
