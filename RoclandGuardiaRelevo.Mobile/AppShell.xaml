<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RoclandGuardiaRelevo.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:RoclandGuardiaRelevo.Mobile.Views"
    Shell.FlyoutBehavior="Disabled"
       BackgroundColor="#FFFFFF"
       TitleColor="#1A1A1A">

    <!-- Login (fuera del main, sin NavBar) -->
    <ShellContent Route="LoginPage"
                  ContentTemplate="{DataTemplate views:LoginPage}"
                  Shell.NavBarIsVisible="False"/>

                  <ShellContent Route="MainPage"
                  ContentTemplate="{DataTemplate views:MainPage}"
                  Shell.NavBarIsVisible="False"/>

    <ShellContent Route="RondinPage" ContentTemplate="{DataTemplate views:RondinPage}" Shell.NavBarIsVisible="False"/>

    <ShellContent Route="FirmaPage" ContentTemplate="{DataTemplate views:FirmaPage}" Shell.NavBarIsVisible="False"/>

</Shell>
